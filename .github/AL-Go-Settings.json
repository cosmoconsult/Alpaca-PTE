{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go-Actions/v9.2/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/microsoft/AL-Go-PTE@main",
  "templateSha": "b7dd1f32feb254e07086096e8970fba1187d9a6e",
  "useCompilerFolder": true,
  "doNotRemovePackagesFolderIfExists": true,
  "runs-on": "ubuntu-latest",
  "shell": "pwsh",
  "githubRunner": "ubuntu-latest",
  "githubRunnerShell": "pwsh",
  "customALGoFiles": {
    "filesToExclude": [
      {
        "sourceFolder": ".github/workflows",
        "filter": "AlpacaSyncSecrets.yaml"
      },
      {
        "sourceFolder": ".github/workflows",
        "filter": "_AlpacaSyncSecrets.yaml"
      }
    ]
  }
}
